{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":410,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"p","props":{},"children":[]},"\n\n"]},{"type":"section","props":{"id":"mwBQ"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Range Debuff"]}," is a debuff applied by enemies that decreases a tower's range. This debuff does not appear anywhere on the tower, though due to how it works, it will reduce the percentage of the ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," on the tower or remove the ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," icon entirely."]},"\n\n"]},{"type":"section","props":{"id":"mwCg"},"children":[{"type":"h2","props":{"id":"Mechanics"},"children":["Mechanics"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Range Debuff"]}," effectively is just a negative ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]},", best seen if a tower affected by it has a ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]},". For example, if a tower with a 20% ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," receives a 15% ",{"type":"b","props":{},"children":["Range Debuff"]},", the ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," will get reduced to 5%. Similarly, if a tower receives a ",{"type":"b","props":{},"children":["Range Debuff"]}," higher than its current ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]},", the icon for it will be removed entirely. For example, if a tower with a 50% ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," will receive a 60% ",{"type":"b","props":{},"children":["Range Debuff"]},", the icon for the buff will disappear and the tower will end up with a 10% ",{"type":"b","props":{},"children":["Range Debuff"]},"."]},"\n\n",{"type":"p","props":{},"children":["The range affected by the ",{"type":"b","props":{},"children":["Range Debuff"]}," is calculated as:"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"b","props":{},"children":["Range × (1 - (Range Debuff - ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]},"))"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":["where ",{"type":"b","props":{},"children":["Range Debuff"]}," and ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," is the debuff supplied by the enemy in decimal form (for example, 10% is 0.1). If the tower has no ",{"type":"a","props":{"href":"/w/Range_Buff","title":"Range Buff"},"children":["Range Buff"]}," on itself, the number for it should be set to 0."]}]}]}]}]}]},"\n\n",{"type":"p","props":{},"children":["The range of a tower affected by the ",{"type":"b","props":{},"children":["Range Debuff"]}," can be in decimal form, instead of being rounded down or rounded up to the nearest integer. For example, a tower with 5 range with a 50% ",{"type":"b","props":{},"children":["Range Debuff"]}," will have a range of 2.5."]},"\n\n",{"type":"p","props":{},"children":["The following towers are either partially or fully not affected by the ",{"type":"b","props":{},"children":["Range Debuff"]},":"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["All ",{"type":"a","props":{"href":"/w/Units","title":"Units"},"children":["units"]},"."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Shotgunner","title":"Shotgunner"},"children":["Shotgunner"]},", as its bullets do not extend into the decreased range."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," cannot have its range boosted by another ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Other range buff sources, like the ",{"type":"a","props":{"href":"/w/Ranger","title":"Ranger"},"children":["Ranger"]},", can still apply it."]}]}]},"\n",{"type":"li","props":{},"children":["Circling/patrol range of the ",{"type":"a","props":{"href":"/w/Pursuit","title":"Pursuit"},"children":["Pursuit"]}," and ",{"type":"a","props":{"href":"/w/Ace_Pilot","title":"Ace Pilot"},"children":["Ace Pilot"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The radius in which towers gain hidden detection from the ",{"type":"a","props":{"href":"/w/Ace_Pilot","title":"Ace Pilot"},"children":["Ace Pilot"]}," also cannot be decreased."]},"\n",{"type":"li","props":{},"children":["These towers' attack range can still be decreased."]}]}]},"\n",{"type":"li","props":{},"children":["The deadzone ranges of towers, like the ",{"type":"a","props":{"href":"/w/Engineer","title":"Engineer"},"children":["Engineer"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The attack range for these towers can still be decreased."]}]}]},"\n",{"type":"li","props":{},"children":["Secondary orange range of towers like the range buff range for the ",{"type":"a","props":{"href":"/w/Ranger","title":"Ranger"},"children":["Ranger"]}," or the gravestone range for the ",{"type":"a","props":{"href":"/w/Necromancer","title":"Necromancer"},"children":["Necromancer"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The main range of these towers can still be decreased."]}]}]},"\n",{"type":"li","props":{},"children":["The chain range of the ",{"type":"a","props":{"href":"/w/Electroshocker","title":"Electroshocker"},"children":["Electroshocker"]}," and ",{"type":"a","props":{"href":"/w/Tesla","title":"Tesla"},"children":["Tesla"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The attack range can still be decreased."]}]}]},"\n",{"type":"li","props":{},"children":["The explosion radius from ",{"type":"a","props":{"href":"/w/Splash_Damage","title":"Splash Damage"},"children":["Splash Damage towers"]}," cannot be decreased."]}]},"\n\n"]},{"type":"section","props":{"id":"mwTA"},"children":[{"type":"h2","props":{"id":"Applied_By"},"children":["Applied By"]},"\n",{"type":"p","props":{},"children":["The following enemies can apply the ",{"type":"b","props":{},"children":["Range Debuff"]}," to towers:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Boomer","title":"Boomer"},"children":["Boomer"]}," (",{"type":"i","props":{},"children":["Weakening Bile"]}," ability)"]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Tanker","title":"Tanker"},"children":["Tanker"]}," (",{"type":"i","props":{},"children":["Toxic Fumes"]}," ability)"]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Elite_Boomer","title":"Elite Boomer"},"children":["Elite Boomer"]}," (",{"type":"i","props":{},"children":["Weakening Bile"]}," ability)"]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Champion_Templar","title":"Champion Templar"},"children":["Champion Templar"]}," (",{"type":"i","props":{},"children":["Hammer Throw"]}," ability)"]}]},"\n\n",{"type":"p","props":{},"children":["The following event enemies can apply the ",{"type":"b","props":{},"children":["Range Debuff"]}," to towers:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"