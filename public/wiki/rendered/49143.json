{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":486,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"p","props":{},"children":[]}]},{"type":"section","props":{"id":"mwAw"},"children":[{"type":"section","props":{"id":"mwBQ"},"children":[{"type":"h2","props":{"id":"Paradoxum_Translators"},"children":["Paradoxum Translators"]},"\n"]},{"type":"span","props":{"id":"mwBg"},"children":["\n\n\n"]},{"type":"p","props":{},"children":[]},"\n"]},{"type":"section","props":{"id":"mwCA"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Paradoxum Translators"]}," was a translation program from ",{"type":"a","props":{"href":"/w/Paradoxum_Games","title":"Paradoxum Games"},"children":["Paradoxum Games"]}," with the goal of translating Tower Defense Simulator into multiple languages. The program is nowadays defunct as it has been replaced by Roblox's automatic translations."]},"\n\n",{"type":"p","props":{},"children":["The position initially was a voluntary position which only granted small in-game benefits, but would later be turned into a paid position."]},"\n\n"]},{"type":"section","props":{"id":"mwDQ"},"children":[{"type":"h2","props":{"id":"Ranks"},"children":["Ranks"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Paradoxum Translators"]}," group had 24 ranks, these are:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Member (1)"]},"\n",{"type":"li","props":{},"children":["Spanish (2)"]},"\n",{"type":"li","props":{},"children":["Korean (3)"]},"\n",{"type":"li","props":{},"children":["German (4)"]},"\n",{"type":"li","props":{},"children":["Malay (5)"]},"\n",{"type":"li","props":{},"children":["Japanese (6)"]},"\n",{"type":"li","props":{},"children":["Russian (7)"]},"\n",{"type":"li","props":{},"children":["Portuguese (8)"]},"\n",{"type":"li","props"