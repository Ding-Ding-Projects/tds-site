e":"Soldier"},"children":["Soldier"]},", ",{"type":"a","props":{"href":"/w/Minigunner","title":"Minigunner"},"children":["Minigunner"]}," and ",{"type":"a","props":{"href":"/w/Sniper","title":"Sniper"},"children":["Sniper"]}," fend off against the zombies while the Recruit is hiding behind some barricades. ",{"type":"a","props":{"href":"/w/Professor_V","title":"Professor V"},"children":["Professor V"]}," informs ",{"type":"a","props":{"href":"/w/Commander","title":"Commander"},"children":["Commander"]}," that the turrets are now online, which leads to the Recruit running up to a red button with a skull on it. This causes a few turrets to pop up, with the one observed by us having a zombie get on top of it. These begin firing at the zombies in the area, clearing out large amounts of them."]},"\n\n",{"type":"p","props":{},"children":["The zombie that was on the turret falls off it once it has stopped firing, then begins trying to run away. It is however interrupted as ",{"type":"a","props":{"href":"/w/Professor_V","title":"Professor V"},"children":["Professor V"]}," tested out her gun on it, which made her find out that the gun disintegrates things it is fired at. She then tries to find out if the agents are fine, though she first gets questions from ",{"type":"a","props":{"href":"/w/Commander","title":"Commander"},"children":["Commander"]}," about finding someone which is interrupted by the ",{"type":"a","props":{"href":"/w/Soldier","title":"Soldier"},"children":["Soldier"]}," who wants to find ",{"type":"a","props":{"href":"/w/Demoman","title":"Demoman"},"children":["Demoman"]}," and ",{"type":"a","props":{"href":"/w/Hops","title":"Hops"},"children":["Hops"]},"."]},"\n\n",{"type":"p","props":{},"children":["While asking her if they are alive, the ",{"type":"a","props":{"href":"/w/Demoman","title":"Demoman"},"children":["Demoman"]}," can be seen walking in the distance with his arm on his stomach. He explains what happened in mines, then brings out ",{"type":"a","props":{"href":"/w/Hops","title":"Hops"},"children":["Hops"]},"' beret which he gives to the ",{"type":"a","props":{"href":"/w/Soldier","title":"Soldier"},"children":["Soldier"]},". He tells him that ",{"type":"a","props":{"href":"/w/Hops","title":"Hops"},"children":["Hops"]}," got taken by the zombies. This is quickly shown to not be true when ",{"type":"a","props":{"href":"/w/Hops","title":"Hops"},"children":["Hops"]}," comes out and slaps the ",{"type":"a","props":{"href":"/w/Soldier","title":"Soldier"},"children":["Soldier"]},"'s shoulder. He at first slightly mad about the situation, though he gets over it and begins laughing."]},"\n\n",{"type":"p","props":{},"children":["The cutscene then changes into a still shot with a brown tint, which is followed by it now showing everyone standing around or on the ",{"type":"a","props":{"href":"/w/Grave_Digger","title":"Grave Digger"},"children":["Grave Digger"]},"'s body. The camera later zooms in on the ",{"type":"a","props":{"href":"/w/Soldier","title":"Soldier"},"children":["Soldier"]}," and ",{"type":"a","props":{"href":"/w/Hops","title":"Hops"},"children":["Hops"]},", which later turns into a photo given to the ",{"type":"a","props":{"href":"/w/Commander","title":"Commander"},"children":["Commander"]}," by the other agents, placed on his computer next to a note with a to do list. In this recruitment center, he is reading the records of the new recruit, which includes their criminal record. This recruit is then revealed to be the ",{"type":"a","props":{"href":"/w/Scout","title":"Scout"},"children":["Scout"]},", ending the cutscene."]},"\n"]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwOA"},"children":[{"type":"h3","props":{"id":"Script"},"children":["Script"]},"\n",{"type":"div","props":{"id":"mwOQ"},"children":["\n",{"type":"div","props":{"id":"mwOg"},"children":[{"type":"b","props":{},"children":["Script"]}]},"\n",{"type":"div","props":{"id":"mwPA"},"children":["\n",{"type":"p","props":{},"children":[{"type":"s