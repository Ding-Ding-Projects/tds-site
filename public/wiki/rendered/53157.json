{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":449,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"p","props":{},"children":[]}]},{"type":"section","props":{"id":"mwAw"},"children":[{"type":"section","props":{"id":"mwBQ"},"children":[{"type":"h2","props":{"id":"Holy_Hand_Grenade"},"children":["Holy Hand Grenade"]},"\n"]},{"type":"span","props":{"id":"mwBg"},"children":["\n\n\n"]},{"type":"p","props":{},"children":[]},{"type":"span","props":{"id":"mwCA"},"children":["\n\n"]},"\n",{"type":"div","props":{"id":"mwCg"},"children":["\n",{"type":"div","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Wiki media omitted"]}]}]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":[{"type":"i","props":{},"children":["An",{"type":"sup","props":{},"children":["[sic]"]}," piece of dee-vine intervention."]},{"type":"br","props":{},"children":[]}]}]},"\n",{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":["―"]},"In-Game Description"]}]}]},"\n"]},"\n","\n"]},{"type":"section","props":{"id":"mwDA"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," is a ",{"type":"a","props":{"href":"/w/Consumables","title":"Consumables"},"children":["consumable"]}," only obtainable through mode triumphs and battle passes."]},"\n\n",{"type":"p","props":{},"children":["Only up to two ",{"type":"b","props":{},"children":["Holy Hand Grenades"]}," can be used in a match by a single player. It has a 120 second cooldown, though when the match first starts, the cooldown is set to 1 second."]},"\n\n"]},{"type":"section","props":{"id":"mwEg"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Holy Hand Grenade"]},",  your avatar's right hand will hold a holy hand grenade, playing a custom idle animation. You will be able to choose an area where the holy hand grenade will be thrown. This will create a massive explosion with a 60 stud radius, dealing 30,000 damage to all enemies within it. Unlike other explosions, the damage does not decrease based on the distance from the center of the explosion. Additionally, the explosion can damage ",{"type":"a","props":{"href":"/w/Lead_(Attribute)","title":"Lead (Attribute)"},"children":["Lead"]}," enemies and despite creating an explosion, it is affected by ",{"type":"a","props":{"href":"/w/Defense","title":"Defense"},"children":["Defense"]},"."]},"\n\n"]},{"type":"section","props":{"id":"mwFw"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," is a white grenade with gold accents, blue buttons and a cross on top."]},"\n\n"]},{"type":"section","props":{"id":"mwGg"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," has lower max possible damage to a single target than the ",{"type":"a","props":{"href":"/w/Nuke","title":"Nuke"},"children":["Nuke"]},", making it worse against them. However, its lack of a damage drop off makes it potentially better against crowds of enemies.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Due to its very high explosion damage, the ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," can be used to deal with high health enemies, like the ",{"type":"a","props":{"href":"/w/Fallen_Honor_Guard","title":"Fallen Honor Guard"},"children":["Fallen Honor Guard"]}," and the ",{"type":"a","props":{"href":"/w/Frost_Hero","title":"Frost Hero"},"children":["Frost Hero"]},"."]}]}]},"\n",{"type":"li","props":{},"children":["Be wary it has a 120 seconds cooldown before using it again."]}]},"\n\n"]},{"type":"section","props":{"id":"mwJQ"},"children":[{"type":"h2","props":{"id":"Trivia"},"children":["Trivia"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," is based on the ",{"type":"a","props":{"href":"https://community.fandom.com/wiki/c:montypython:Holy%20Hand%20Grenade%20of%20Antioch","title":"w:c:montypython:Holy Hand Grenade of Antioch"},"children":["Holy Hand Grenade of Antioch"]}," from the 1975 British comedy film ",{"type":"i","props":{},"children":["Monty Python and the Holy Grail"]},"."]},"\n",{"type":"li","props":{},"children":["It is the first and currently the only exclusive ",{"type":"a","props":{"href":"/w/Consumables","title":"Consumables"},"children":["Consumable"]}," in the game.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Despite this the category for exclusive ",{"type":"a","props":{"href":"/w/Consumables","title":"Consumables"},"children":["Consumables"]}," has existed in the game long before the ",{"type":"b","props":{},"children":["Holy Hand Grenade"]},"."]}]}]},"\n",{"type":"li","props":{},"children":["During development, the ",{"type":"b","props":{},"children":["Holy Hand Grenade"]}," had a function more akin to the ",{"type":"a","props":{"href":"/w/Nuke","title":"Nuke"},"children":["Nuke"]},".",{"type":"sup","props":{},"children":[{"type":"a","props":{"href":"/w/Holy_Hand_Grenade#cite_note-1"},"children":[{"type":"span","props":{"id":"mwNQ"},"children":[{"type":"span","props":{"id":"mwNg"},"children":["["]},"1",{"type":"span","props":{"id":"mwNw"},"children":["]"]}]}]}]}]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Holy Hand Grenade's"]}," description may be a ",{"type":"a","props":{"h