},"children":["The Final Act Event"]},"."]},"\n\n",{"type":"p","props":{},"children":["During the ",{"type":"a","props":{"href":"/w/Lunar_Overture_Event","title":"Lunar Overture Event"},"children":["Lunar Overture Event"]},", when used, the ",{"type":"b","props":{},"children":["Spotlight"]}," fired a beam of light that followed the player's cursor. This beam of light would have confused most enemies, making them go backwards. For the ",{"type":"a","props":{"href":"/w/Left_Hand","title":"Left Hand"},"children":["Left Hand"]}," and ",{"type":"a","props":{"href":"/w/Right_Hand","title":"Right Hand"},"children":["Right Hand"]},", it would have dealt a huge amount of damage instead. The beam would have lasted six seconds and it costed ten ",{"type":"a","props":{"href":"/w/Battery","title":"Battery"},"children":["Batteries"]}," to use it."]},"\n\n",{"type":"p","props":{},"children":["During ",{"type":"a","props":{"href":"/w/The_Final_Act_Event","title":"The Final Act Event"},"children":["The Final Act Event"]},", when the ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]}," uses its ",{"type":"i","props":{},"children":["The Final Act"]}," ability, four ",{"type":"b","props":{},"children":["Spotlights"]}," activate. Using a Spotlight will make the beam of light follow the player's cursor. Clicking or tapping will lock on the beam to its desired spot. When all four spotlights are aimed on the ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]},", it will disable the ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]},"'s ability from damaging the base. The ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]}," will glow yellow, indicating that its ability was interrupted."]},"\n\n"]},{"type":"section","props":{"id":"mwIg"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Spotlight"]}," was shaped like a tall stage light, similar to those used in filming or in stage production. The tower that the ",{"type":"b","props":{},"children":["Spotlight"]}," was mounted on was a dark brown tower. The head rotated around the center pivot to face the player's cursor. The beam emitted was a straight laser like yellow beam."]},"\n\n"]},{"type":"section","props":{"id":"mwJg"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["In the final wave, when the ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]}," performs ",{"type":"i","props":{},"children":["The Final Act"]}," ability, the ",{"type":"b","props":{},"children":["Spotlight"]}," can be used to stop it.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["There are four ",{"type":"b","props":{},"children":["Spotlights "]},"in total that you can activate at the side of the map. Once it is activated, redirect it to the ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]},"."]},"\n",{"type":"li","props":{},"children":["You can target multiple ",{"type":"b","props":{},"children":["Spotlights"]}," at once; it is easier than targeting one ",{"type":"b","props":{},"children":["Spotlight"]}," at a time."]}]}]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Narrator_(Enemy)","title":"Narrator (Enemy)"},"children":["Narrator"]}," will be highlighted in yellow if all ",{"type":"b","props":{},"children":["Spotlights"]}," are successfully redirected to it, allowing player to know they succeeded stopped it from using this ability."]}]},"\n\n"]},{"type":"section","props":{"id":"mwNg"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["12 November 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.9.0","title":"V1.9.0"},"children":["v1.9.0l"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Spotlight"]}," added."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["12 November 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.9.0","title":"V1.9.0"},"children":["v1.9.0m"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["DPS decreased from 25,000 to 10,000."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["12 November 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.9.0","title":"V1.9.0"},"children":["v1.9.0n"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Spotlight"]}," duration increased from 5 to 20 seconds."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["24 November 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.9.4","title":"V1.9.4"},"children":["v1.9.4"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Spotlight"]}," duration decreased from 20 to 3 seconds."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["1 December 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.9.4","title":"V1.9.4"},"children":["v1.9.4b"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Spotlight"]}," duration increased from 3 to 6 seconds."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["21 December 2023"]}," - ",{"type":"a","props":{"href":"/w/V1.11.0","title":"V1.11.0"},"children":["v1.11.0"]},"\n",{"type":"ul","pr