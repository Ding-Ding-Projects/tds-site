, which rounds up to 8."]},"\n\n",{"type":"p","props":{},"children":["The shield health gained from this modifier can affect enemy abilities. For example, if an enemy changes its statistics upon losing all of its shield health, like the ",{"type":"a","props":{"href":"/w/Rusher","title":"Rusher"},"children":["Rusher"]},", shield health gained from ",{"type":"b","props":{},"children":["Mutation"]}," modifier also needs to be decreased and not just the base shield health."]},"\n\n"]},{"type":"section","props":{"id":"mwRw"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"div","props":{"id":"mwSA"},"children":["\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["29 July 2022"]}," - ",{"type":"a","props":{"href":"/w/V1.3.0","title":"V1.3.0"},"children":["v1.3.0"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Mutation"]}," added."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["30 September 2022"]}," - ",{"type":"a","props":{"href":"/w/V1.4.0","title":"V1.4.0"},"children":["v1.4.0"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Mutation"]}," is now active in ",{"type":"a","props":{"href":"/w/Badlands_II","title":"Badlands II"},"children":["Badlands II"]},"."]},"\n",{"type":"li","props":{},"children":["Shield health is now increased by 5% of the enemy's normal health instead of 10%."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["31 October 2022"]}," - ",{"type":"a","props":{"href":"/w/V1.4.2","title":"V1.4.2"},"children":["v1.4.2"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Mutation"]}," is now active in ",{"type":"a","props":{"href":"/w/Pizza_Party","title":"Pizza Party"},"children":["Pi