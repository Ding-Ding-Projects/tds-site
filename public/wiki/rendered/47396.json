r_Eclipse_Event","title":"Solar Eclipse Event"},"children":["Solar Eclipse Event"]},"."]},"\n\n",{"type":"p","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Narrator_(Story)","title":"Narrator (Story)"},"children":["Narrator"]}," shows the ",{"type":"a","props":{"href":"/w/Scout","title":"Scout"},"children":["Scout"]},", ",{"type":"a","props":{"href":"/w/Gladiator","title":"Gladiator"},"children":["Gladiator"]}," and ",{"type":"a","props":{"href":"/w/Commander","title":"Commander"},"children":["Commander"]},", all as popsicle cutouts, confronting ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," and defeating her. After finishing, he thanks the audience and talks to them about ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]},"."]},"\n\n",{"type":"p","props":{},"children":["He gets cut off by ",{"type":"a","props":{"href":"/w/Penumbras","title":"Penumbras"},"children":["Penumbras"]}," falling down from the ceiling with the ",{"type":"a","props":{"href":"/w/God_Cube","title":"God Cube"},"children":["God Cube"]},", so that he can inform the ",{"type":"a","props":{"href":"/w/Narrator_(Story)","title":"Narrator (Story)"},"children":["Narrator"]}," that he managed collect all the fragments to rebuild it. He then wants to bring back ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," with it, however, the ",{"type":"a","props":{"href":"/w/Narrator_(Story)","title":"Narrator (Story)"},"children":["Narrator"]},", gets into an argument with him. ",{"type":"a","props":{"href":"/w/Penumbras","title":"Penumbras"},"children":["Penumbras"]},", confused why he is lashing out on him keeps asking if they can revive her."]},"\n\n",{"type":"p","props":{},"children":["Since ",{"type":"a","props":{"href":"/w/Penumbras","title":"Penumbras"},"children":["Penumbras"]}," has served his purpose and ruined their plans, the ",{"type":"a","props":{"href":