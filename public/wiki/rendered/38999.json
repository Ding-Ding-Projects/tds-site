{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":688,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"div","props":{"id":"mwAg"},"children":[{"type":"span","props":{"id":"mwAw"},"children":[{"type":"b","props":{},"children":["Profile Cards"]}]},"\n",{"type":"hr","props":{},"children":[]},"\n\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Profile Cards"]}," are cards that appear when viewing yours or another player's profile. These display information about the player, such as their loadout or triumph count. Profile cards can be shown by clicking on a player's username in the leaderboard and then using the ",{"type":"i","props":{},"children":["View Profile"]}," button or by clicking on the player in the lobby."]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwCg"},"children":[{"type":"h2","props":{"id":"PVE_Profile_Cards"},"children":["PVE Profile Cards"]},"\n",{"type":"figure","props":{"id":"mwCw"},"children":[{"type":"a","props":{"href":"/w/File:ProfileCardLeaderboard.png"},"children":["Wiki media omitted"]},{"type":"figcaption","props":{},"children":[]}]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["PVE Profile Cards"]}," are profile cards that appear next to the leaderboard. These can be seen anywhere in the game. These contain the following information about the player:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Player's display name, username and an image of their avatar with a map in the background.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["It was possible to set the background to most maps by triumphing them, then going to the ",{"type":"a","props":{"href":"/w/Rewards#Scores","title":"Rewards"},"children":["Scores"]}," section of ",{"type":"a","props":{"href":"/w/Rewards","title":"Rewards"},"children":["Rewards"]}," and pressing the ",{"type":"i","props":{},"children":["Set Profile"]}," button. ",{"type":"a","props":{"href":"/w/Grass_Isle","title":"Grass Isle"},"children":["Grass Isle"]}," is used as the default background. This is no longer possible, as it has been removed from the game. While the ",{"type":"a","props":{"href":"/w/Index","title":"Index"},"children":["Index"]}," does exist, it has no option of changing the background image."]}]}]},"\n",{"type":"li","props":{},"children":["Earned medals for ",{"type":"a","props":{"href":"/w/Easy_Mode","title":"Easy Mode"},"children":["Easy"]},", ",{"type":"a","props":{"href":"/w/Molten_Mode","title":"Molten Mode"},"children":["Molten"]}," and ",{"type":"a","props":{"href":"/w/Fallen_Mode","title":"Fallen Mode"},"children":["Fallen"]}," modes.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["As ",{"type":"a","props":{"href":"/w/Hardcore_Mode","title":"Hardcore Mode"},"children":["Hardcore"]},", ",{"type":"a","props":{"href":"/w/Casual_Mode","title":"Casual Mode"},"children":["Casual"]}," and ",{"type":"a","props":{"href":"/w/Intermediate_Mode","title":"Intermediate Mode"},"children":["Intermediate"]}," modes do not have medals, they are not included there."]},"\n",{"type":"li","props":{},"children":["As medals are not tracked correctly, this counter is incorrect."]}]}]},"\n",{"type":"li","props":{},"children":["Win ratio, calculated by dividing triumphs by losses.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["If a player has zero losses, their win ratio is shown as 1."]},"\n",{"type":"li","props":{},"children":["Triumphs and losses can be seen on the leaderboard."]}]}]},"\n",{"type":"li","props":{},"children":["Number of cleared maps.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The number of maps cleared is not tracked correctly, making this counter incorrect."]}]}]},"\n",{"type":"li","props":{},"children":["Tower loadout.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Towers use their default skin icons."]},"\n",{"type":"li","props":{},"children":["Consumable loadout is not displayed."]},"\n",{"type":"li","props":{},"children":["PVP loadout is not displayed."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwMQ"},"children":[{"type":"h2","props":{"id":"PVP_Profile_Cards"},"children":["PVP Profile Cards"]},"\n",{"type":"figure","props":{"id":"mwMg"},"children":[{"type":"a","props":{"href":"/w/File:PVPProfileCard.png"},"children":["Wiki media omitted"]},{"type":"figcaption","props":{},"children":[]}]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["PVP Profile Cards"]}," are profile cards that appear next to the leaderboard. These can be seen anywhere in the game. These contain the following information about the player:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Player's display name, username and an image of their avatar.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Similarly to the ",{"type":"b","props":{},"children":["PVE Profile Cards"]},", there is an area which would normally be reserved for a map background, though it goes unused and instead displays a simple grey background instead."]}]}]},"\n",{"type":"li","props":{},"children":["Win and loss counter for ",{"type":"a","props":{"href":"/w/PVP","title":"PVP"},"children":["PVP"]}," mode.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Wins and losses are only tracked for the ",{"type":"a","props":{"href":"/w/PVP","title":"PVP"},"children":["PVP"]}," mode. Wins or losses from the ",{"type":"a","props":{"href":"/w/PVP_Test","title":"PVP Test"},"children":["PVP Test"]}," or even the original ",{"type":"a","props":{"href":"/w/Versus","title":"Versus"},"children":["Versus"]}," mode are not included."]}]}]},"\n",{"type":"li","props":{},"children":["Enemies killed and enemies sent counters.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Similarly to wins and losses, only lists statistics for the ",{"type":"a","props":{"href":"/w/PVP","title":"PVP"},"children":["PVP"]}," mode."]}]}]},"\n",{"type":"li","props":{},"children":["Player's current rank.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Visually, the icon will always be displayed as General."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwTA"},"children":[{"type":"h2","props":{"id":"Player_Profile_Cards"},"children":["Player Profile Cards"]},"\n",{"type":"figure","props":{"id":"mwTQ"},"children":[{"type":"a","props":{"href":"/w/File:ProfileCardLegacy.png"},"children":["Wiki media omitted"]},{"type":"figcaption","props":{},"children":[]}]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Player Profile Cards"]}," are profile cards that appear on the player. These can only be seen in the lobby, and it can only be opened on a smartphone or any other device without the on-screen leaderboard. On computers, it is also possible to resize the Roblox window to be of smaller size, which disabled the leaderboard and enables the ",{"type":"b","props":{},"children":["Player Profile Cards"]},". The background of the profile card is by default ",{"type":"a","props":{"href":"/w/Grass_Isle","title":"Grass Isle"},"children":["Grass Isle"]},", though it could have been changed to most maps if triumphed and then set in the ",{"type":"a","props":{"href":"/w/Rewards#Scores","title":"Rewards"},"children":["Scores"]}," section of ",{"type":"a","props":{"href":"/w/Rewards","title":"Rewards"},"children":["Rewards"]}," by pressing the ",{"type":"i","props":{},"children":["Set Profile"]}," button. This is no longer possible, as this section and later ",{"type":"a","props":{"href":"/w/Rewards","title":"Rewards"},"children":["Rewards"]}," feature itself have been removed. While the ",{"type":"a","props":{"href":"/w/Index","title":"Index"},"children":["Index"]}," does exist, it has no option of changing the background image. These contain the following information about the player:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The player's username and an image of their avatar.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The display name is not shown."]}]}]},"\n",{"type":"li","props":{},"children":["The player's ",{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Level "]}]}," and rank.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Ranks are a never fully implemented feature. Ranks would be given to players every 5 Levels, with there being bronze, silver and gold tier. They were meant to appear in chat, player lists and the leaderboard. The rank displayed is always the same, being ",{"type":"span","props":{"id":"mwYw"},"children":[{"type":"span","props":{"id":"mwZA"},"children":["Wiki media omitted"]}]},"Bronze VIII, which was meant to be given to players with ",{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Level 40-44"]}]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Player Profile Cards"]}," alongside some badges are the only places they still appear in."]}]}]}]}]},"\n",{"type":"li","props":{},"children":["The player's ",{"type":"span","props":{"id":"mwbA"},"children":[{"type":"span","props":{"id":"mwbQ"},"children":["Wiki media omitted"]}]},"triumphs, ",{"type":"span","props":{"id":"mwcA"},"children":[{"type":"span","props":{"id":"mwcQ"},"children":["Wiki media omitted"]}]},"wins and ",{"type":"span","props":{"id":"mwdA"},"children":[{"type":"span","props":{"id":"mwdQ"},"children":["Wiki media omitted"]}]},"losses.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Wins from the ",{"type":"a","props":{"href":"/w/PVP_Test","title":"PVP Test"},"children":["PVP Test"]}," do not increase the win counter."]}]}]},"\n",{"type":"li