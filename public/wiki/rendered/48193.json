ops":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Wiki media omitted"]}]}]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":[{"type":"i","props":{},"children":["Place a temporary barricade with 300 health. Gradually spawns crab units out of it."]},{"type":"br","props":{},"children":[]}]}]},"\n",{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":["―"]},"Former In-game description"]}]}]},"\n"]},"\n","\n"]},{"type":"section","props":{"id":"mwDg"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Sandcastle"]},", sometimes referred to as ",{"type":"b","props":{},"children":["Sandcastle Barricade"]},", is a ",{"type":"a","props":{"href":"/w/Consumables","title":"Consumables"},"children":["consumable"]}," that spawns ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crabs"]}," to attack for it if no enemies reach the ",{"type":"b","props":{},"children":["Sandcastle"]},", but this decreases the health with time. It can be obtained from the ",{"type":"a","props":{"href":"/w/Surf_&_Turf_Battle_Pass","title":"Surf & Turf Battle Pass"},"children":["Surf & Turf Battle Pass"]}," and by triumphing the main survival modes."]},"\n\n",{"type":"p","props":{},"children":["Only up to four ",{"type":"b","props":{},"children":["Sandcastle"]}," can be used in a match by a single player. It has a 60 second cooldown, though when the match first starts the cooldown is set to 45 seconds."]},"\n\n"]},{"type":"section","props":{"id":"mwGA"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Sandcastle"]},", the player's avatar's right hand will hold a hammer, throw into the air and then catch it, playing a custom idle animation. The player can then select a place to build the sandcastle, which places it down and can take up to 1,000 damage before being destroyed. Enemies do not deal increased damage to it if they have defense. It can deal damage to ",{"type":"a","props":{"href":"/w/Lead_(Attribute)","title":"Lead (Attribute)"},"children":["Lead"]}," enemies but it is unable to deal damage to ",{"type":"a","props":{"href":"/w/Ghost_(Attribute)","title":"Ghost (Attribute)"},"children":["Ghost"]}," enemies, though it can still receive damage from them. Enemies which have the same or higher health than the ",{"type":"b","props":{},"children":["Sandcastle"]}," will instantly destroy it while receiving no damage. For high health enemies like ",{"type":"a","props":{"href":"/w/Fallen_Giant","title":"Fallen Giant"},"children":["Fallen Giant"]}," which have a higher health than the ",{"type":"b","props":{},"children":["Barricade"]},", if its reduced to health that is lower than it the ",{"type":"b","props":{},"children":["Sandcastle"]}," will still be destroyed, however, the ",{"type":"a","props":{"href":"/w/Fallen_Giant","title":"Fallen Giant"},"children":["Fallen Giant"]}," will receive some damage which will be lower than the ",{"type":"b","props":{},"children":["Sandcastle's"]}," health."]},"\n\n",{"type":"p","props":{},"children":["If it is not destroyed instantly by enemies, it will begin summoning a ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crab"]}," every second. These ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crabs"]}," have 25 health and take away 25 health from the ",{"type":"b","props":{},"children":["Sandcastle"]},". The ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crabs"]}," act identically to other collision only units like the ",{"type":"a","props":{"href":"/w/Humvee","title":"Humvee"},"children":["Humvee"]},"."]},"\n\n"]},{"type":"section","props":{"id":"mwKQ"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Sandcastle"]}," is a giant sandcastle with a few plastic shovels and fans. It has a blue bucket as an entrance, from which it spawns in ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crabs"]},"."]},"\n\n"]},{"type":"section","props":{"id":"mwLQ"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Sandcastle"]}," has more health than the ",{"type":"a","props":{"href":"/w/Barricade","title":"Barricade"},"children":["Barricade"]},", as well as spawning ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crabs"]},", making it significantly better than it.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Do note that the ",{"type":"b","props":{},"children":["Sandcastle"]}," loses 25 health by every ",{"type":"a","props":{"href":"/w/Crab","title":"Crab"},"children":["Crab"]}," that is spawned, making it temporary."]}]}]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Sandcastle"]}," should mainly be used in early game to help better defend. By mid game, it does not have enough health to protect you from stronger enemies."]}]},"\n\n"]},{"type":"section","props":{"id":"mwOQ"},"children":[{"type":"h2","props":{"id":"Gallery"},"children":["Gallery"]},"\n",{"type":"div","props":{"id":"mwOg"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Props"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwPQ"},"children":[{"type":"span","props":{"id":"mwPg"},"children":[{"type":"a","props":{"href":"/w/File:ConsumablePropSandcastle.png",