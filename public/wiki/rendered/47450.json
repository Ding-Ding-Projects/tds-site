ation that is located near the Main Bridge."]},"\n\n",{"type":"p","props":{},"children":["In Chapter 1 of ",{"type":"a","props":{"href":"/w/Story_Mode","title":"Story Mode"},"children":["Story Mode"]},", the train station was used as a rest stop by the ",{"type":"a","props":{"href":"/w/Commander","title":"Commander"},"children":["Commander"]},"'s team and the Abandoned City survivors before continuing on their journey to ",{"type":"a","props":{"href":"/w/Cyber_City","title":"Cyber City"},"children":["Cyber City"]},"."]},"\n",{"type":"div","props":{"id":"mwsw"},"children":[]},"\n\n"]},{"type":"section","props":{"id":"mwtA"},"children":[{"type":"h3","props":{"id":"Crystal_Cave"},"children":["Crystal Cave"]},"\n",{"type":"p","props":{},"children":[]},"\n",{"type":"p","props":{},"children":[{"type":"a","props":{"href":"/w/Crystal_Cave","title":"Crystal Cave"},"children":["Crystal Cave"]}," is a mine used by ",{"type":"a","props":{"href":"/w/Cyber_City","title":"Cyber City"},"children":["Cyber City"]}," to extract crystals, a source of energy used to power ",{"type":"a","props":{"href":"/w/Cyber_City","title":"Cyber City"},"children":["Cyber City"]},". The ",{"type":"a","props":{"href":"/w/Trapper","title":"Trapper"},"children":["Trapper"]}," has been working in the mines of ",{"type":"a","props":{"href":"/w/Crystal_Cave","title":"Crystal Cave"},"children":["Crystal Cave"]}," as a watchman ever since he was kicked out of the T.D.S. training program."]},"\n\n",{"type":"p","props":{},"children":["In Chapter 1 of ",{"type":"a","props":{"href":"/w/Story_Mode","title":"Story Mode"},"children":["Story Mode"]},", ",{"type":"a","props":{"href":"/w/Crystal_Cave","title":"Crystal Cave"},"children":["Crystal Cave"]}," was used as an escape route from ",{"type":"a","props":{"href":"/w/Night_Station","title":"Night Station"},"children":["Night Station"]}," by the T.D.S. agents and the Abandoned City survivors to get away from the zombies that were catching up to them."]},"\n",{"type"