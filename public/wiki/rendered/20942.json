Blaster"]}," and ",{"type":"a","props":{"href":"/w/Freezer","title":"Freezer"},"children":["Freezer"]},"."]},"\n\n",{"type":"p","props":{},"children":["In addition, ",{"type":"a","props":{"href":"/w/Units","title":"Units"},"children":["units"]}," ignored defense for their collision damage. However, for their other sources of damage (like ranged damage for the ",{"type":"a","props":{"href":"/w/Crook","title":"Crook"},"children":["Crook"]}," and ",{"type":"a","props":{"href":"/w/Humvee_3","title":"Humvee 3"},"children":["Humvee 3"]},", or melee damage for the ",{"type":"a","props":{"href":"/w/Citizen_1","title":"Citizen 1"},"children":["Citizen 1"]},"), these damage values were affected by defense."]},"\n\n",{"type":"p","props":{},"children":["The following towers affecting defense are listed below."]},"\n\n",{"type":"table","props":{"id":"mwAYw"},"children":["\n",{"type":"tbody","props":{},"children":[{"type":"tr","props":{},"children":[{"type":"td","props":{"id":"mwAY8"},"children":[{"type":"span","props":{"id":"mwAZA"},"children":[{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}]},"\n",{"type":"td","props":{"id":"mwAZY"},"children":["With each tick, the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," melted ",{"type":"i","props":{},"children":["Total Defense"]}," of all enemies on fire by 1 at Level 2-4, and by 2 at Level 5.\n\n",{"type":"p","props":{},"children":["Could only melt 50% of ",{"type":"i","props":{},"children":["Total Defense"]},"."]}]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAZw"},"children":[{"type":"span","props":{"id":"mwAZ0"},"children":[{"type":"a","props":{"href":"/w/Freezer","title":"Freezer"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":