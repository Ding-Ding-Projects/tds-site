dren":["Can only melt 20% of ",{"type":"i","props":{},"children":["Percentage Defense"]},"."]}]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAT4"},"children":[{"type":"span","props":{"id":"mwAT8"},"children":[{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}]},"\n",{"type":"td","props":{"id":"mwAUU"},"children":["The ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," melts ",{"type":"i","props":{},"children":["Percentage Defense"]}," by a flat amount with a red track pulse hit, with base decrease being 5%, which increases by 1% for every tower in range up to 25%.\n\n",{"type":"p","props":{},"children":["Cannot melt defense further than what its defense melt per hit is."]}]}]},"\n"]}]},"\n\n"]},{"type":"section","props":{"id":"mwAUk"},"children":[{"type":"h3","props":{"id":"Prior_to_the_Frost_Invasion_Update"},"children":[{"type":"span","props":{"id":"mwAUo"},"children":[{"type":"a","props":{"href":"/w/File:DefenseOld.png"},"children":["Wiki media omitted"]}]},"Prior to the Frost Invasion Update"]},"\n",{"type":"p","props":{},"children":["There were two types of defense statistic. One was the ",{"type":"i","props":{},"children":["Effective Defense"]}," and the other was ",{"type":"i","props":{},"children":["Total Defense"]},"."]},"\n\n",{"type":"p","props":{},"children":[{"type":"i","props":{},"children":["Total Defense"]}," was the actual defense number you see on an enemy. However, a tower's damage was rarely reduced by this number."]},"\n\n",{"type":"p","props":{},"children":[{"type":"i","props":{},"children":["Effective Defense"]}," was the actual number that was taken away from a tower's damage towards the enemy. Each point of ",{"type":"i","props":{},"children":["Effective Defense"]}," melted damage by one point, with ",{"type":"i","props":{},"children":["Effective Defense"]}," varying depending on the difficulty of the match. When calculating ",{"type":"i","props":{},"children":["Effective Defense"]},", if the number was a decimal, ",{"type":"i","props":{},"children":["Effective Defense"]}," is rounded up. However, the damage of towers could not be lowered below half."]},"\n\n",{"type":"section","props":{"id":"mwAVk"},"children":[{"type":"h4","props":{"id":"Match_Multiplier"},"children":["Match Multiplier"]},"\n",{"type":"table","props":{"id":"mwAVo"},"children":["\n",{"type":"tbody","props":{},"children":[{"type":"tr","props":{},"children":["\n",{"type":"th","props":{"id":"mwAV0"},"children":["Mode"]},"\n",{"type":"th","props":{"id":"mwAV4"},"children":["Defense Multiplier"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAWA"},"children":[{"type":"b","props":{},"children":["Normal"]}]},"\n",{"type":"td","props":{"id":"mwAWI"},"children":["Effective Defense = (Total Defense × 0.25)"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAWQ"},"children":[{"type":"b","props":{},"children":["Molten"]}]},"\n",{"type":"td","props":{"id":"mwAWY"},"children":["Effective Defense = (Total Defense × 0.35)"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAWg"},"children":[{"type":"b","props":{},"children":["Fallen"]}]},"\n",{"type":"td","props":{"id":"mwAWo"},"children":["Effective Defense = (Total Defense × 0.5)"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAWw"},"children":[{"type":"b","props":{},"children":["Hardcore"]}]},"\n",{"type":"td","props":{"id":"mwAW4"},"children":["Effective Defense = (Total Defense × 0.75)"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwAXA"},"children":[{"type":"b","props":{},"children":[{"type":"a","props":{"href":"/w/Trick_or_Threat_Town","title":"Trick or Threat Town"},"children":["Trick or Threat 