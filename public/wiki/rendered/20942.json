{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":1186,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"p","props":{},"children":[]}]},{"type":"section","props":{"id":"mwAw"},"children":[{"type":"section","props":{"id":"mwBQ"},"children":[]},{"type":"section","props":{"id":"mwBw"},"children":[{"type":"h2","props":{"id":"Defense"},"children":["Defense"]},"\n"]},{"type":"span","props":{"id":"mwCA"},"children":["\n\n\n"]},{"type":"p","props":{},"children":[]},{"type":"span","props":{"id":"mwCg"},"children":["\n\n"]},"\n\n"]},{"type":"section","props":{"id":"mwDA"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Defense"]}," is a status value given to certain enemies and units. Enemies may spawn with this naturally, or be granted this through a litany of means."]},"\n\n"]},{"type":"section","props":{"id":"mwDw"},"children":[{"type":"h2","props":{"id":"Mechanics"},"children":["Mechanics"]},"\n",{"type":"p","props":{},"children":["There are two types of defense statistic. The main defense statistic is ",{"type":"i","props":{},"children":["Percentage Defense"]}," which is used to calculate ",{"type":"i","props":{},"children":["Effective Damage"]},"."]},"\n\n",{"type":"p","props":{},"children":[{"type":"i","props":{},"children":["Percentage Defense"]}," is the actual defense percentage you see on an enemy or unit. However, this does not mean that if an enemy has 50% defense damage dealt towards it will be decreased 50%. In reality, the number listed is far closer to the percentage of additional health that ",{"type":"b","props":{},"children":["Defense"]}," gives it."]},"\n\n",{"type":"p","props":{},"children":[{"type":"i","props":{},"children":["Effective Damage"]}," is the actual damage dealt towards an enemy by a tower once ",{"type":"i","props":{},"children":["Percentage Defense"]}," is applied. ",{"type":"i","props":{},"children":["Effective Damage"]}," is calculated by calculating"]},"\n\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"b","props":{},"children":["Original Damage ÷ (1 + Percentage Defense)"]}]}]}]}]},"\n\n",{"type":"p","props":{},"children":["where ",{"type":"i","props":{},"children":["Percentage Defense"]}," is changed from a percentage into its equivalent decimal number (for instance, 50% would be 0.5 in decimal form). For example, a tower that deals 100 damage attacking an enemy with 50% defense would deal 67 damage as 100 ÷ (1 + 0.5) = 66.67 to two decimal places. Due to ",{"type":"i","props":{},"children":["Effective Damage"]}," always being rounded up to the nearest integer, 66.67 rounds up to 67. Prior to the ",{"type":"a","props":{"href":"/w/V1.1.0","title":"V1.1.0"},"children":["Entity System Update"]},", ",{"type":"i","props":{},"children":["Effective Damage"]}," was always rounded down to the nearest integer."]},"\n\n",{"type":"p","props":{},"children":["Unit defense works identically to enemy defense, reducing damage from enemy abilities and collision."]},"\n\n",{"type":"p","props":{},"children":["A list of certain ",{"type":"i","props":{},"children":["Percentage Defense"]}," values and how much damage they actually reduce has been provided below. This is not a comprehensive list and the values may not be fully accurate due to how the game rounds up the damage, making the values occasionally lower."]},"\n",{"type":"table","props":{"id":"mwKA"},"children":["\n",{"type":"tbody","props":{},"children":[{"type":"tr","props":{},"children":[{"type":"th","props":{"id":"mwKw"},"children":["Percentage Defense"]},"\n",{"type":"th","props":{"id":"mwLA"},"children":["Damage Reduced"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwLg"},"children":["10%"]},"\n",{"type":"td","props":{"id":"mwLw"},"children":["9.09%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwMQ"},"children":["15%"]},"\n",{"type":"td","props":{"id":"mwMg"},"children":["13.04%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwNA"},"children":["20%"]},"\n",{"type":"td","props":{"id":"mwNQ"},"children":["16.67%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwNw"},"children":["25%"]},"\n",{"type":"td","props":{"id":"mwOA"},"children":["20%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwOg"},"children":["35%"]},"\n",{"type":"td","props":{"id":"mwOw"},"children":["25.93%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwPQ"},"children":["40%"]},"\n",{"type":"td","props":{"id":"mwPg"},"children":["28.57%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwQA"},"children":["50%"]},"\n",{"type":"td","props":{"id":"mwQQ"},"children":["33.33%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwQw"},"children":["60%"]},"\n",{"type":"td","props":{"id":"mwRA"},"children":["37.5%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwRg"},"children":["80%"]},"\n",{"type":"td","props":{"id":"mwRw"},"children":["44.44%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwSQ"},"children":["100%"]},"\n",{"type":"td","props":{"id":"mwSg"},"children":["50%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwTA"},"children":["150%"]},"\n",{"type":"td","props":{"id":"mwTQ"},"children":["60%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwTw"},"children":["200%"]},"\n",{"type":"td","props":{"id":"mwUA"},"children":["66.67%"]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwUg"},"children":["300%"]},"\n",{"type":"td","props":{"id":"mwUw"},"children":["75%"]}]},"\n"]}]},"\n\n",{"type":"section","props":{"id":"mwVA"},"children":[{"type":"h3","props":{"id":"Countering_Defense"},"children":["Countering Defense"]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Defense"]}," can reduce the damage output of most towers significantly."]},"\n\n",{"type":"p","props":{},"children":["There are a couple of towers and consumables that can melt the ",{"type":"i","props":{},"children":["Percentage Defense"]}," value of enemies, allowing your towers to deal more damage. A few certain towers can also ignore defense. There are two types of defense melting towers. The first has them decrease ",{"type":"i","props":{},"children":["Total Defense"]}," by a certain percentage. However, if the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]},", which melts defense by 50%, is decreasing defense of ",{"type":"a","props":{"href":"/w/Fallen_Hero","title":"Fallen Hero"},"children":["Fallen Hero"]},", which has 50% defense, this does not mean its defense will be lowered to 0%. Instead, it is decreased by 25% defense, as which is 50% of 50% defense. The defense removal can stack, so the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," and ",{"type":"a","props":{"href":"/w/Electroshocker","title":"Electroshocker"},"children":["Electroshocker"]}," can together remove 70% ",{"type":"i","props":{},"children":["Percentage Defense"]},", but two ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancers"]}," cannot remove 100% ",{"type":"i","props":{},"children":["Percentage Defense"]},". Instead, only 50% ",{"type":"i","props":{},"children":["Percentage Defense"]}," can be melted. Additionally, defense melting from burn cannot stack with other burn towers, freeze defense melting cannot stack with other freeze towers and poison defense melting cannot stack with other poison towers."]},"\n\n",{"type":"p","props":{},"children":["The second type has them decrease ",{"type":"i","props":{},"children":["Total Defense"]}," by a flat amount. For example, the ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," at maximum power can melt 25% defense. This means that when melting defense of the ",{"type":"a","props":{"href":"/w/Fallen_Giant","title":"Fallen Giant"},"children":["Fallen Giant"]},", it will will melt its defense from 60% to 35%."]},"\n\n",{"type":"p","props":{},"children":["Both forms of defense melting do not interfere with each other and can stack. For example, if the ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," decreases the ",{"type":"a","props":{"href":"/w/Vindicator_(Legacy)","title":"Vindicator (Legacy)"},"children":["Vindicator"]},"'s defense from 100% to 75%, the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," will reduce it from 75% to 25%, which is the same decrease (50% less defense) as if ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," did not affect it. Likewise, if the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," decreases the ",{"type":"a","props":{"href":"/w/Vindicator_(Legacy)","title":"Vindicator (Legacy)"},"children":["Vindicator"]},"'s defense from 100% to 50%, the ",{"type":"a","props":{"href":"/w/DJ_Booth","title":"DJ Booth"},"children":["DJ Booth"]}," will still be able to decrease it by 25%, from 50% to 25%."]},"\n\n",{"type":"p","props":{},"children":["Most splash damage will deal full damage to enemies with defense, no matter the percentage, though not all of them do. If a tower that deals explosion damage has orange indicators appear when it deals damage, that means it should be able to bypass defense. If the tower has the regular, red indicators, this is affected by defense."]},"\n\n",{"type":"p","props":{},"children":["In addition, units and the ",{"type":"a","props":{"href":"/w/Trapper","title":"Trapper"},"children":["Trapper"]}," ignore defense for their collision damage. However, for their other sources of damage (like ranged damage for the ",{"type":"a","props":{"href":"/w/Humvee_3","title":"Humvee 3"},"children":["Humvee 3"]},", burn damage for the ",{"type":"a","props":{"href":"/w/Trapper","title":"Trapper"},"children":["Trapper"]}," or melee damage for the ",{"type":"a","props":{"href":"/w/Guardian_Elf","title":"Guardian Elf"},"children":["Guardian Elf"]},"), these damage values are affected by defense. Enemies do not ignore defense by colliding with units, damage dealt to a unit with defense from collision will be reduced."]},"\n\n",{"type":"p","props":{},"children":["Due to a bug, poison and electric defense melting cannot melt the defense of any enemies added or updated starting from the ",{"type":"a","props":{"href":"/w/V1.17.2","title":"V1.17.2"},"children":["April Fools 2024"]}," update, though any of the enemies before that are still affected."]},"\n\n",{"type":"p","props":{},"children":["The following towers and consumables affecting defense are listed below."]},"\n\n",{"type":"table","props":{"id":"mwdw"},"children":["\n",{"type":"tbody","props":{},"children":[{"type":"tr","props":{},"children":[{"type":"th","props":{"id":"mweg","colSpan":2},"children":[{"type":"span","props":{"id":"mwew"},"children":[{"type":"span","props":{"id":"mwfA"},"children":["Burn"]}]},{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Burn"]}]}]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwgQ"},"children":[{"type":"span","props":{"id":"mwgg"},"children":[{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}]},"\n",{"type":"td","props":{"id":"mwiA"},"children":["With each tick, the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," melts ",{"type":"i","props":{},"children":["Percentage Defense"]}," of all enemies on fire by 5% at Level 3-4, and by 10% at Level 5.\n\n",{"type":"p","props":{},"children":["Can only melt 50% of ",{"type":"i","props":{},"children":["Percentage Defense"]},". Defense melting cannot stack with other burn defense melting sources."]}]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwjg"},"children":[{"type":"span","props":{"id":"mwjw"},"children":[{"type":"a","props":{"href":"/w/Golden_Pyromancer","title":"Golden Pyromancer"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":"a","props":{"href":"/w/Golden_Pyromancer","title":"Golden Pyromancer"},"children":["Golden Pyromancer"]}]},"\n",{"type":"td","props":{"id":"mwlQ"},"children":["With each tick, the ",{"type":"a","props":{"href":"/w/Golden_Pyromancer","title":"Golden Pyromancer"},"children":["Golden Pyromancer"]}," melts ",{"type":"i","props":{},"children":["Percentage Defense"]}," of all enemies on fire by 5% at Level 3, and by 10% at Level 4-5.\n\n",{"type":"p","props":{},"children":["Can only melt 50% of ",{"type":"i","props":{},"children":["Percentage Defense"]},". Defense melting cannot stack with other burn defense melting sources."]}]}]},"\n",{"type":"tr","props":{},"children":["\n",{"type":"td","props":{"id":"mwmw"},"children":[{"type":"span","props":{"id":"mwnA"},"children":[{"type":"a","props":{"href":"/w/Molten_Monster","title":"Molten Monster"},"children":["Wiki media omitted"]}]},{"type":"br","props":{},"children":[]},{"type":"a","props":{"href":"/w/Molten_Monster","title":"Molten Monster"},"children":["Molten Monster"]}]},"\n",{"type":"td","props":{"id":"mwog"},"children":["With each tick, the ",{"type":"a","props":{"href":"/w/Molten_Monster","title":"Molten Monster"},"children":["Molten Monster"]}," melts ",{"type":"i","props":{