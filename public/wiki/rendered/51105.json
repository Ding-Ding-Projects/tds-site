{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":422,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"div","props":{"id":"mwAg"},"children":[{"type":"div","props":{},"children":[{"type":"b","props":{},"children":["Necromancer's Tome"]}]},{"type":"div","props":{},"children":[{"type":"b","props":{},"children":["Consumable"]}," • ",{"type":"a","props":{"href":"/w/Necromancer's_Tome_(Emote)","title":"Necromancer's Tome (Emote)"},"children":["Emote"]}]}]},"\n",{"type":"div","props":{"id":"mwAw"},"children":[{"type":"div","props":{},"children":[{"type":"b","props":{},"children":["Similar Article"]}]},"This article is about ",{"type":"b","props":{},"children":["Necromancer",{"type":"span","props":{},"children":["'"]},"s Tome (Consumable)"]},". You may be looking for other uses of ",{"type":"a","props":{"href":"/w/Necromancer_(Disambiguation)","title":"Necromancer (Disambiguation)"},"children":["Necromancer"]},"."]},"\n",{"type":"p","props":{},"children":[]}]},{"type":"section","props":{"id":"mwBQ"},"children":[{"type":"section","props":{"id":"mwBw"},"children":[{"type":"h2","props":{},"children":[{"type":"span","props":{"id":"Necromancer.27s_Tome_.28Consumable.29"},"children":[]},"Necromancer's Tome (Consumable)"]},"\n"]},{"type":"span","props":{"id":"mwCA"},"children":["\n\n\n"]},{"type":"p","props":{},"children":[]},{"type":"span","props":{"id":"mwCg"},"children":["\n\n"]},"\n",{"type":"div","props":{"id":"mwDA"},"children":["\n",{"type":"div","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Wiki media omitted"]}]}]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":[{"type":"i","props":{},"children":["For the next 10 seconds any enemy killed spawns one of Necromancer's units at random."]},{"type":"br","props":{},"children":[]}]}]},"\n",{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":["―"]},"In-Game Description"]}]}]},"\n"]},"\n","\n"]},{"type":"section","props":{"id":"mwDg"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Necromancer's Tome"]}," is an event consumable that can be obtained from the ",{"type":"a","props":{"href":"/w/Null_&_Void_Event","title":"Null & Void Event"},"children":["Null & Void Event"]},". When used, it will cause ",{"type":"a","props":{"href":"/w/Necromancer","title":"Necromancer"},"children":["Necromancer"]},"'s units to spawn from the entrance for every killed enemy."]},"\n\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Necromancer's Tome"]}," can be used two times by a player in a single match. It has a 60 second cooldown, but when the match starts, it is set to 45."]},"\n\n"]},{"type":"section","props":{"id":"mwFQ"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Necromancer's Tome"]},", the player will pull out the ",{"type":"a","props":{"href":"/w/Necromancer","title":"Necromancer"},"children":["Necromancer"]},"'s tome and hold it in their hands. They will then be given the option to cast a spell on any area, though this is purely visual as the area selected has no impact on the skeletons spawned."]},"\n\n",{"type":"p","props":{},"children":["After being used, any enemy killed by most sources will turn into a skeleton unit that will appear from the entrance. These can be:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Skeleton_(Unit)","title":"Skeleton (Unit)"},"children":["Skeleton"]},", with a 70% chance."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Sword_Skeleton","title":"Sword Skeleton"},"children":["Sword Skeleton"]},", with a 20% chance."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Skeleton_Knight","title":"Skeleton Knight"},"children":["Skeleton Knight"]},", with a 5% chance."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Giant_Skeleton_(Unit)","title":"Giant Skeleton (Unit)"},"children":["Giant Skeleton"]},", with a 2% chance."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Hallow_Guard_(Unit)","title":"Hallow Guard (Unit)"},"children":["Hallow Guard"]},", with a 2% chance."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Executioner_Skeleton","title":"Executioner Skeleton"},"children":["Executioner Skeleton"]},", with a 1% chance."]}]},"\n\n",{"type":"p","props":{},"children":["While most sources of damage can summon them, there are certain ways of dealing damage which will not create skeletons:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Damage from ",{"type":"a","props":{"href":"/w/Cryomancer","title":"Cryomancer"},"children":["Cryomancer"]},"'s chillness is completely unable to generate skeletons."]},"\n",{"type":"li","props":{},"children":["Units, regardless if from the ",{"type":"b","props":{},"children":["Necromancer's Tome"]}," or a tower, cannot summon skeletons."]},"\n",{"type":"li","props":{},"children":["Consumables like the ",{"type":"a","props":{"href":"/w/Grenade","title":"Grenade"},"children":["Grenade"]}," are incapable of creating skeletons."]}]},"\n\n"]},{"type":"section","props":{"id":"mwLw"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Necromancer's Tome"]}," is a tome with a skull on its front."]},"\n\n"]},{"type":"section","props":{"id":"mwMg"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Necromancer's Tome"]}," is best used on waves that contain multiple easy to kill enemies.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Summoner enemies like the ",{"type":"a","props":{"href":"/w/Fallen_Necromancer","title":"Fallen Necromancer"},"children":["Fallen Necromancer"]}," are best for this, as they will keep on summoning more enemies to convert into skeletons.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["It is also possible to intentionally leave such enemies on the map as long as possible to make them generate more enemies, increasing how many skeletons you make."]}]}]}]}]},"\n",{"type":"li","props":{},"children":["It is advised to not use this if your main source of damage comes from units, as these do not generate skeletons.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Similarly, any damaging consumables should not be used while this is active as they cannot generate them either."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwPg"},"children":[{"type":"h2","props":{"id":"Gallery"},"children":["Gallery"]},"\n",{"type":"div","props":{"id":"mwPw"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Props"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwQg"},"children":[{"type":"span","props":{"id":"mwQw"},"children":[{"type":"a","props":{"href":"/w/File:ConsumablePropNecromancerTome.png","title":"Necromancer Tome"},"children":["Necromancer Tome"]}]}]},{"type":"div","props":{"id":"mwRw"},"children":["Necromancer Tome"]}]},"\n"]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwSA"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type"