{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":234,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"p","props":{},"children":[]},"\n\n"]},{"type":"section","props":{"id":"mwBQ"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Cost Debuff"]}," is a debuff that increases a tower's placement and upgrade costs, but not ability costs. What is affected depends what it is applied by, as in some cases the ",{"type":"b","props":{},"children":["Cost Debuff"]}," only affects the upgrade cost. This debuff is not displayed anywhere on the tower, the only way to tell it has been applied is by seeing the costs get boosted."]},"\n\n"]},{"type":"section","props":{"id":"mwCQ"},"children":[{"type":"h2","props":{"id":"Mechanics"},"children":["Mechanics"]},"\n",{"type":"p","props":{},"children":["When applied, any affected cost is increased using this equation:"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"b","props":{},"children":["Cost × (1 + Cost Debuff)"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":["where ",{"type":"b","props":{},"children":["Cost Debuff"]}," is the buff supplied in decimal form (for example, 10% is 0.1)."]}]}]}]}]}]},"\n\n",{"type":"p","props":{},"children":["The placement and upgrade costs are rounded down to the nearest integer."]},"\n\n",{"type":"p","props":{},"children":["Certain ",{"type":"b","props":{},"children":["Cost Debuffs"]}," affect both tower placement and upgrade costs, and others only affect upgrade costs. Neither of them have shown to be able to affect ability usage costs. Towers that were placed down or upgraded while being affected the ",{"type":"b","props":{},"children":["Cost Debuff"]}," will give you more cash back when sold, in comparison to those that were not affected by it."]},"\n\n"]},{"type":"section","props":{"id":"mwGA"},"children":[{"type":"h2","props":{"id":"Applied_By"},"children":["Applied By"]},"\n",{"type":"p","props":{},"children":["The following gamemodes used to apply the ",{"type":"b","props":{},"children":["Cost Debuff"]}," to towers:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/MEGA_Servers","title":"MEGA Servers"},"children":["MEGA Servers"]}," (Placement and upgrade cost)"]}]},"\n\n",{"type":"p","props":{},"children":["The following modifiers apply the ",{"type":"b","props":{},"children":["Cost Debuff"]}," to towers:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Inflation","title":"Inflation"},"children":["Inflation"]}," (Placement, ability and upgrade cost)"]}]},"\n\n",{"type":"p","props":{},"children":["The following towers used to have the ",{"type":"b","props":{},"children":["Cost Debuff"]},":"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Golden"]}]}," ",{"type":"a","props":{"href":"/w/Scout","title":"Scout"},"children":["Scout"]}," (Upgrade cost only)"]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Golden"]}]}," ",{"type":"a","props":{"href":"/w/Cowboy","title":"Cowboy"},"children":["Cowboy"]}," (Upgrade cost only)"]}]},"\n\n",{"type":"p","props":{},"children":["The following removed gamemodes could apply the ",{"type":"b","props":{},"children":["Cost Debuff"]}," to towers:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Halloween_2020_Event","title":"Halloween 2020 Event"},"children":["Halloween 2020 Event"]}," (Upgrade cost only)"]}]},"\n\n"]},{"type":"section","props":{"id":"mwMQ"},"childr