},"."]},"\n\n",{"type":"p","props":{},"children":["Only five ",{"type":"b","props":{},"children":["Flashbangs"]}," can be used in a single match by a single player. It has a 5 second cooldown."]},"\n\n"]},{"type":"section","props":{"id":"mwFg"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Flash Bang"]},", your avatar's right hand will hold a stun grenade, playing a custom idle animation. You will be able to choose an area where the flash grenade will be thrown. This will make it create a small explosion with a radius of 6.5, applying a five second stun to all enemies caught in it. If an enemy is immune to stuns in any way, the following things will happen based on the immunity:"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["If the enemy is ",{"type":"a","props":{"href":"/w/Stun_Immunity","title":"Stun Immunity"},"children":["Stun Immune"]},", it will receive the regular 40% slowdown."]},"\n",{"type":"li","props":{},"children":["If the enemy is a ",{"type":"a","props":{"href":"/w/Boss","title":"Boss"},"children":["Boss"]},", it will receive a unique slowness debuff that slows it down by 50%."]}]},"\n\n"]},{"type":"section","props":{"id":"mwHg"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Flash Bang's"]}," appearance is a dark green M84 stun grenade, with a glowing yellow interior and a thick cyan line painted on the middle of the exterior. "]},"\n\n"]},{"type":"section","props":{"id":"mwIQ"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Flash Bang"]}," can be helpful for stalling fast enemies such as the ",{"type":"a","props":{"href":"/w/Error","title":"Error"},"children":["Error"]}," or ",{"type":"a","props":{"href":"/w/Rusher","title":"Rusher"},"children":["Rusher"]},", giving your towers more time to attack them.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Do note that several fast enemies have stun immunity, such as the ",{"type":"a","props":{"href":"/w/Fallen","title":"Fallen"},"children":["Fallen"]}," or ",{"type":"a","props":{"href":"/w/Circuit_(Polluted_Wasteland_II)","title":"Circuit (Polluted Wasteland II)"},"children":["Circuit"]},", so the ",{"type":"b","props":{},"children":["Flash Bang"]}," will be less effective against those."]},"\n",{"type":"li","props":{},"children":["Additionally, you should be quick with using the ",{"type":"b","props":{},"children":["Flash Bang"]}," so you do not accidentally miss."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwLg"},"children":[{"type":"h2","props":{"id":"Gallery"},"children":["Gallery"]},"\n",{"type":"div","props":{"id":"mwLw"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Props"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwMg"},"children":[{"type":"span","props":{"id":"mwMw"},"children":[{"type":"a","props":{"href":"/w/File:ConsumablePropFlashBang.png","title":"Flash Bang"},"children":["Flash Bang"]}]}]},{"type":"div","props":{"id":"mwNw"},"children":["Flash Bang"]}]},"\n"]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwOA"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["10 May 2024"]}," - ",{"type":"a","props":{"href":"/w/V1.21.0","title":"V1.21.0"},"children":["v1.21.0"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Flash Bang"]}," added."]},"