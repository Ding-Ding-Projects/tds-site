Crate"},"children":["Mid Grade Crate"]},"."]},"\n\n",{"type":"p","props":{},"children":["Only up to five ",{"type":"b","props":{},"children":["Molotovs"]}," can be used in a match. It has a 25 second cooldown, though when the match first starts, the cooldown is reduced to 15 seconds."]},"\n\n"]},{"type":"section","props":{"id":"mwFw"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Molotov"]},", your avatar's right hand will hold a Molotov cocktail, playing a custom idle animation. You will be able to choose an area where the Molotov cocktail will be thrown. This will make it create a 6.5 stud radius puddle of fire, setting any enemy that enters it on fire. This wall of fire lasts for 10 seconds. Enemies will be set on fire for 6 seconds, receiving 10 damage every 0.5 seconds (12 DPS), dealing 96 damage in total. It will also drop their defense by 15% every tick. It can only drop up to 50% of the enemy's defense. As it drops it through fire, any other fire based defense dropping, such as the ",{"type":"a","props":{"href":"/w/Pyromancer","title":"Pyromancer"},"children":["Pyromancer"]}," or ",{"type":"a","props":{"href":"/w/Napalm_Strike","title":"Napalm Strike"},"children":["Napalm Strike"]},", will not stack with it."]},"\n\n"]},{"type":"section","props":{"id":"mwHA"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Molotov"]}," is a translucent green colored glass bottle with a blank label. It has a piece of cloth wick sticking out of the bottle's mouth, which is used to set the ",{"type":"b","props":{},"children":["Molotov"]}," on fire."]},"\n\n"]},{"type":"section","props":{"id":"mwIA"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Molotov"]}," is best used against large numbers of fast enemies such as the ",{"type":"a","props":{"href":"/w/Glitch","title":"Glitch"},"children":["Glitch"]},". Throwing it in front of the enemies will allow the ",{"type":"b","props":{},"children":["Molotov"]}," to set fire to several enemies before the fire disappears."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Molotov"]}," can be effective in reducing the defense of enemies with high defense such as the ",{"type":"a","props":{"href":"/w/Fallen_Guardian","title":"Fallen Guardian"},"children":["Fallen Guardian"]}," if defense dropping towers are not placed down."]},"\n",{"type":"li","props":{},"children":["It is worth noting that the ",{"type":"b","props":{},"children":["Molotov"]}," can bounce off the path, which can make it unreliable.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["To maximize the chances of the ",{"type":"b","props":{},"children":["Molotov"]}," hitting, it is recommended to face the same direction as the path."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwLg"},"children":[{"type":"h2","props":{"id":"Gallery"},"children":["Gallery"]},"\n",{"type":"div","props":{"id":"mwLw"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Props"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwMg"},"children":[{"type":"span","props":{"id":"mwMw"},"children":[{"type":"a","props":{"href":"/w/File:ConsumablePropMolotov.png","title":"Molotov"},"children":["Molotov"]}]}]},{"type":"div","props":{"id":"mwNw"},"children":["Molotov"]}]},"\n"]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwOA"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"chil