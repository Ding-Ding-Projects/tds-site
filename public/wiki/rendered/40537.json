entical to ",{"type":"i","props":{},"children":["Invincibility"]},", except it does not allow units to pass through it."]}]},"\n\n",{"type":"p","props":{},"children":["Currently, all three function very similarly, preventing all forms of damage. In the past, the first type did not make it immune to collision damage, though that was changed in the ",{"type":"a","props":{"href":"/w/Overhaul_v1.0","title":"Overhaul v1.0"},"children":["Overhaul Update"]},", while the second type simply made the enemy destroy any unit while invulnerable, though this was changed in ",{"type":"a","props":{"href":"/w/V1.17.0","title":"V1.17.0"},"children":["v1.17.0"]},". Both of them now make units pass through them, though the third type, ",{"type":"b","props":{},"children":["God"]},", kills them instead."]},"\n\n"]},{"type":"section","props":{"id":"mwIQ"},"children":[{"type":"h2","props":{"id":"Enemy_List"},"children":["Enemy List"]},"\n",{"type":"section","props":{"id":"mwIg"},"children":[{"type":"h3","props":{"id":"Full_Immunity_2"},"children":["Full Immunity"]},"\n",{"type":"p","props":{},"children":["The following enemies can, at one point, have ",{"type":"b","props":{},"children":["Full Immunity"]},":"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Fallen_King_(Legacy)","title":"Fallen King (Legacy)"},"children":["Fallen King"]}," (Legacy version, ",{"type":"i","props":{},"children":["Block"]},", ",{"type":"i","props":{},"children":["Rage Mode"]},")"]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Fallen_Swordmaster","title":"Fallen Swordmaster"},"children":["Fallen Swordmaster"]}," (",{"type":"i","props":{},"children":["Refusing Will"]},")"]}]},"\n\n",{"type":"p","props":{},"children":["The following event enemies also had ",{"type":"b","props":{},"children":["Full Immunity"]},":"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Kra