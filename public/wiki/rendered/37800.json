","props":{"href":"/w/VIP+","title":"VIP+"},"children":["VIP+"]},") chance to be gotten from a ",{"type":"a","props":{"href":"/w/Mid_Grade_Crate","title":"Mid Grade Crate"},"children":["Mid Grade Crate"]},"."]},"\n\n",{"type":"p","props":{},"children":["Only up to three ",{"type":"b","props":{},"children":["AirStrikes"]}," can be used in a match by a single player. It has a 45 second cooldown, though when the match first starts the cooldown is set to 30 seconds."]},"\n\n"]},{"type":"section","props":{"id":"mwGg"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["AirStrike"]},", your avatar's right hand will hold a radio, playing a custom idle animation. You will be able to choose an area where the ",{"type":"b","props":{},"children":["AirStrike"]}," will fire missiles at. These six missiles will create explosions with a big radius, dealing a fixed 400 damage to any enemy caught within range, dealing up to 2,400 total damage, except for enemies with defense. It is unable to deal damage to ",{"type":"a","props":{"href":"/w/Lead_(Attribute)","title":"Lead (Attribute)"},"children":["Lead"]}," enemies."]},"\n\n"]},{"type":"section","props":{"id":"mwHw"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["AirStrike"]}," is a Grumman F-14D Tomcat that fires missiles. The inventory and hotbar icon shows two white bombs with red stripes on them in the top right corner to indicate that it is the ",{"type":"b","props":{},"children":["AirStrike"]}," consumable."]},"\n\n"]},{"type":"section","props":{"id":"mwIw"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["AirStrike"]}," can be effective against groups of hig