mwGQ"},"children":[{"type":"h2","props":{"id":"Official_Description"},"children":["Official Description"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Online (Third)"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":["He is big. He is bad. He is bunny-shaped. With Nerd Ducky at the controls, this Mecha Bunny mini plush is ready to cause chaos and conquer your heart with a single quack. The in-game reward is only included with purchases made in Roblox. Items purchased from shop.paradoxum.games do not include an in-game reward."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Online (Second)"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":["He’s big. He’s bad. He’s bunny-shaped, and he's 10% off until April 21! With Nerd Ducky at the controls, this Mecha Bunny mini plush is ready to cause chaos and conquer your heart with a single quack."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Online (First)"]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":["He’s big. He’s bad. He’s bunny-shaped, and he's 10% off until April 21! With Nerd Ducky at the controls, this Mecha Bunny mini plush is ready to cause chaos and conquer your heart with a single quack. Plus, score a FREE in-game skin with your purchase!"]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwJw"},"children":[{"type":"h2","props":{},"children":[{"type":"span","props":{"id":"Prices_.26_Stores"},"children":[]},"Prices & Stores"]},"\n",{"type":"p","props":{},"children":["Prices may vary by country due to shipping fees and local currency. The ",{"type":"b","props":{},"children":["Mecha Bunny + Nerd Ducky Mini Plush"]}," is priced at $23.99, discounted from $29.99."]},"\n\n",{"type":"p","props":{},"children":["Originally, it had a cost of $27.99."]},"\n\n",{"type":"p","props":{},"children":