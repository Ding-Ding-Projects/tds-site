progression of health increase from 2 players onwards, similar to survival servers.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["After the ",{"type":"a","props":{"href":"/w/Release_v1.0","title":"Release v1.0"},"children":["MEGA Update"]},", health increase was similar, though it only applied to ",{"type":"b","props":{},"children":["MEGA Servers"]},", not survival servers. This was removed on the 26th of January 2020 and replaced with tower cost scaling."]},"\n",{"type":"li","props":{},"children":["However, health scaling was added back for final bosses on the 11th of February 2020 and certain other enemies after the 4th of March 2020."]}]}]},"\n",{"type":"li","props":{},"children":["Prior to the ",{"type":"a","props":{"href":"/w/Release_v1.0","title":"Release v1.0"},"children":["MEGA Update"]},", only players that were ",{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Level 15+"]}]}," had access to these servers.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["Prior to the ",{"type":"a","props":{"href":"/w/Overhaul_v1.0","title":"Overhaul v1.0"},"children":["Overhaul Update"]},", all towers and upgrades were 20% more expensive in ",{"type":"b","props":{},"children":["MEGA Servers"]},"."]},"\n",{"type":"li","props":{},"children":["In the ",{"type":"a","props":{"href":"/w/Overhaul_v1.3","title":"Overhaul v1.3"},"children":["Frost Invasion Update"]},", ",{"type":"b","props":{},"children":["MEGA Servers"]}," had a ",{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Level 15+"]}]}," requirement, but due to a bug you were still able to enter ",{"type":"b","props":{},"children":["MEGA Servers"]}," without being ",{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Level 15+"]}]},"."]}]}]},"\n",{"type":"li","props":{},"children":["You could not have triggered the ",{"type":"a","props":{"href":"/w/Hidden_Wave_(Legacy)","title":"Hidden Wave (Legacy)"},"children":["legacy Hidden Wave"]}," on a ",{"type":"b","props":{},"children":["MEGA Server"]}," via the time requirement.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["However, if 4 or less players were left in the server before wave 40 was completed, then you could have still triggered the ",{"type":"a","props":{"href":"/w/Hidden_Wave_(Legacy)","title":"Hidden Wave (Legacy)"},"children":["Hidden Wave"]}," via the time requirement."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/Maps","title":"Maps"},"children":["Maps"]}," completed on a ",{"type":"b","props":{},"children":["MEGA Server"]}," counted towards the removed ",{"type":"a","props":{"href":"/w/Platinum_Crate","title":"Platinum Crate"},"children":["Platinum Crate"]},"."]},"\n",{"type":"li","props":{},"children":["Prior to the ",{"type":"a","props":{"href":"/w/Overhaul_v1.3","title":"Overhaul v1.3"},"children":["Frost Invasion Update"]},", ",{"type":"b","props":{},"children":["MEGA Servers"]}," could hold up to eight players."]}]},"\n\n"]},{"type":"section","props":{"id":"mwARo"},"children":[{"type":"h2","props":{"id":"Notes"},"children":["Notes"]},"\n",{"type":"div","props":{"id":"mwARs"},"children":[{"type":"ol","props":{},"children":[{"type":"li","props":{},"children":[{"type":"span","props":{"id":"mwAR0"},"children":[{"type":"a","props":{"href":"/w/MEGA_Servers#cite_ref-adm_1-0"},"children":[{"type":"span","props":{"id":"mwAR8"},"children":["1 "]}]},{"type":"a","props":{"href":"/w/MEGA_Servers#cite_ref-adm_1-1"},"children":[{"type":"span","props":{"id":"mwASE"},"children":["2 "]}]},{"type":"a","props":{"href":"/w/MEGA_Servers#cite_ref-adm_1-2"},"children":[{"type":"span","props":{"id":"mwASM"},"children":["3 "]}]},{"type":"a","props":{"href":"/w/MEGA_Servers#cite_ref-adm_1-3"},"children":[{"type":"span","props":{"id":"mwASU"},"children":["4 "]}]}]}," ",{"type":"span","props":{"id":"mw-reference-text-cite_note-adm-1"},"children":["Did not