{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":207,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"div","props":{"id":"mwAg"},"children":[]},{"type":"div","props":{"id":"mwAw"},"children":["\n",{"type":"div","props":{},"children":[{"type":"div","props":{},"children":[{"type":"b","props":{},"children":["Removed Content"]}]},"\n",{"type":"div","props":{},"children":["\n",{"type":"hr","props":{},"children":[]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Hardcore Lobby has been removed from the game as of the 8th of May 2021."]},{"type":"br","props":{},"children":[]},"Hardcore Lobby may still exist in the game's code, though it is no longer officially used in-game. This page has been preserved for historical purposes."]},"\n"]}]}]},"\n",{"type":"p","props":{},"children":[]},"\n"]},{"type":"section","props":{"id":"mwBg"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":[{"type":"b","props":{},"children":["Hardcore Lobby"]}," was a lobby which functioned similarly to the ",{"type":"a","props":{"href":"/w/Main_Lobby","title":"Main Lobby"},"children":["Main Lobby"]},", however, rather than housing survival ",{"type":"a","props":{"href":"/w/Elevators","title":"Elevators"},"children":["Elevators"]},", its ",{"type":"a","props":{"href":"/w/Elevators","title":"Elevators"},"children":["Elevators"]}," would be used to start ",{"type":"a","props":{"href":"/w/Hardcore_Mode","title":"Hardcore Mode"},"children":["Hardcore"]}," matches."]},"\n\n",{"type":"p","props":{},"children":["It contained a few ",{"type":"a","props":{"href":"/w/Elevators","title":"Elevators"},"children":["Elevators"]},", ",{"type":"a","props":{"href":"/w/Leaderboard","title":"Leaderboard"},"children":["Leaderboards"]}," and a crate opening area."]},"\n\n"]},{"type":"section","props":{"id":"mwEA"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Hardcore Lobby"]}," was located on a few black platforms with neon lights. One giant platform had a purple ball and a portal to the ",{"type":"a","props":{"href":"/w/Main_Lobby","title":"Main Lobby"},"children":["Main Lobby"]},". Stairs lead to three other portions of the map, first being a small are containing ",{"type":"a","props":{"href":"/w/Leaderboard","title":"Leaderboard"},"children":["Leaderboards"]}," and purple buttons that did nothing, but could be pressed. On the opposite end there was a crate opening area. The middle area is the spot where all the ",{"type":"a","props":{"href":"/w/Elevators","title":"Elevators"},"children":["Elevators"]}," are located. They are all for ",{"type":"a","props":{"href":"/w/Hardcore_Mode","title":"Hardcore Mode"},"children":["Hardcore"]}," mode, meaning they go through a set of maps specific to that mode."]},"\n\n"]},{"type":"section","props":{"id":"mwFw"},"children":[{"type":"h2","props":{"id":"Soundtracks"},"children":["Soundtracks"]},"\n",{"type":"div","props":{"id":"mwGA"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Lobby Theme"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwGw"},"children":[{"type":"span","props":{"id":"mwHA"},"children":[{"type":"span","props":{"id":"mwHQ"},"children":[]}]}]},{"type":"div","props":{"id":"mwIA"},"children":[{"type":"a","props":{"href":"/w/Hardcore_Testing_BETA","title":"Hardcore Testing BETA"},"children":["Hardcore Testing BETA"]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwIw"},"children":[{"type":"span","props":{"id":"mwJA"},"children":[{"type":"span","props":{"id":"mwJQ"},"children":[]}]}]},{"type":"div","props":{"id":"mwKA"},"children":["29 October 2020 – 8 May 2021"]}]},"\n"]},"\n"]},"\n\n"]}