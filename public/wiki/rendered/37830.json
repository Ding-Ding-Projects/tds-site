"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag"]},", referred to as ",{"type":"b","props":{},"children":["Fire Rate Flag"]}," in the pop up message that appears when used, is one of the four rare ",{"type":"a","props":{"href":"/w/Consumables","title":"Consumables"},"children":["consumables"]},". The ",{"type":"b","props":{},"children":["Cooldown Flag"]}," has a 2.78% (5.41% with ",{"type":"a","props":{"href":"/w/VIP+","title":"VIP+"},"children":["VIP+"]},") chance to be gotten from a ",{"type":"a","props":{"href":"/w/Low_Grade_Crate","title":"Low Grade Crate"},"children":["Low Grade Crate"]},", a 6.15% (9.41% with ",{"type":"a","props":{"href":"/w/VIP+","title":"VIP+"},"children":["VIP+"]},") chance to be gotten from a ",{"type":"a","props":{"href":"/w/Mid_Grade_Crate","title":"Mid Grade Crate"},"children":["Mid Grade Crate"]}," and a 22.03% (21.67% with ",{"type":"a","props":{"href":"/w/VIP+","title":"VIP+"},"children":["VIP+"]},") chance to be gotten from a ",{"type":"a","props":{"href":"/w/High_Grade_Crate","title":"High Grade Crate"},"children":["High Grade Crate"]},"."]},"\n\n",{"type":"p","props":{},"children":["Only up to three ",{"type":"b","props":{},"children":["Cooldown Flags"]}," can be used in a match by a single player. It has a 60 second cooldown, though when the match first starts, the cooldown is set to 45 seconds. Its cooldown does not start until the ",{"type":"b","props":{},"children":["Cooldown Flag"]}," disappears."]},"\n\n"]},{"type":"section","props":{"id":"mwHA"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["When using the ",{"type":"b","props":{},"children":["Cooldown Flag"]},", a flag pole with a yellow flag will appear, which can be placed on any part of the map. When placed down, it will give a 20% ",{"type":"a","props":{"href":"/w/Firerate_Buff","title":"Firerate Buff"},"children":["Firerate Buff"]}," to all towers in its 16 range for 45 seconds. This buff does not stack with other ",{"type":"b","props":{},"children":["Cooldown Flag's"]}," ",{"type":"a","props":{"href":"/w/Firerate_Buff","title":"Firerate Buff"},"children":["Firerate Buffs"]},"."]},"\n\n"]},{"type":"section","props":{"id":"mwIg"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag"]}," is a yellow flag with a long grey pole. The flag has a small white circle, with the fire rate buff icon in front of the circle."]},"\n\n"]},{"type":"section","props":{"id":"mwJQ"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag's"]}," firerate boost is calculated as\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"b","props":{},"children":["Original Firerate ÷ 1.2"]}]},"\n",{"type":"dd","props":{},"children":["where ",{"type":"i","props":{},"children":["Original Firerate"]}," is the intended base firerate of a tower,"]}]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["For example, the ",{"type":"b","props":{},"children":["Cooldown Flag"]}," would decrease the firerate of a ",{"type":"a","props":{"href":"/w/Towers","title":"Towers"},"children":["tower"]}," firing from 1 second to 0.833 seconds.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["While in the game it may look like the firerate is rounded down to the second decimal, this is only visual. The firerate is longer than that and is not rounded up."]}]}]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag"]}," cannot boost the delay between firing a projectile and the projectile landing (and dealing damage) that is present for some towers, as this is not incorporated into the firerate. An example of this is the delay between projectile firing and landing for the ",{"type":"a","props":{"href":"/w/Mortar","title":"Mortar"},"children":["Mortar"]},"."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag"]}," cannot decrease the cooldown of burst towers."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Cooldown Flag"]}," also cannot boost the ",{"type":"a","props":{"href":"/w/Executioner","title":"Executioner"},"children":["Executioner"]}," due to the axe not returning in time to take advantage."]}]}]}]},"\n\n"]},{"type":"section","props":{"id":"mwPQ"},"children":[{"type":"h2","props":{"id":"Gallery"},"children":["Gallery"]},"\n",{"type":"div","props":{"id":"mwPg"},"children":["\n\n",{"type":"p","props":{},"children":[{"type":"span","props":{},"children":[{"type":"b","props":{},"children":["Props"]}]}]},"\n",{"type":"ul","props":{},"children":["\n",{"type":"li","props":{},"children":[{"type":"div","props":{"id":"mwQQ"},"children":[{"type":"span","props":{"id":"mwQg"},"children":[{"type":"a","props":{"href":"/w/File:ConsumablePropCooldownFlag.png","title":"Cooldown Flag"},"children":["Cooldown Flag"]}]}]},{"type":"div","props":{"id":"mwRg"},"children":["Cooldown Flag"]}]},"\n"]},"\n"]},"\n\n"]},{"type":"section","props":{"id":"mwRw"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["10 May 2024"]}," - ",{"type":"a","props":{"href":"/w/V1.21.0","title":"V1.21.0"},"children":["v1.21.0"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Cooldown Flag"]}," added."]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":[{"type":"span","props":{},"children":["Bug"]}]},{"type":"span","props":{},"children":[":"]}," Lifespan timer does 