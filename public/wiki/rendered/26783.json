{"schemaVersion":1,"source":"MediaWiki REST revision HTML, sanitized","nodeCount":422,"content":[{"type":"section","props":{"id":"mwAQ"},"children":[{"type":"div","props":{"id":"mwAg"},"children":[{"type":"div","props":{},"children":[{"type":"b","props":{},"children":["Similar Article"]}]},"This article is about ",{"type":"b","props":{},"children":["Star Cannon"]},". You may be looking for the ",{"type":"a","props":{"href":"/w/Eggveloper_Cannon_9002","title":"Eggveloper Cannon 9002"},"children":["Eggveloper Cannon 9002"]},", the ",{"type":"a","props":{"href":"/w/Eggmin_Cannon_9000","title":"Eggmin Cannon 9000"},"children":["Eggmin Cannon 9000"]},", or the ",{"type":"a","props":{"href":"/w/Star_Creaeggtor_Cannon_9001","title":"Star Creaeggtor Cannon 9001"},"children":["Star Creaeggtor Cannon 9001"]},"."]},"\n",{"type":"p","props":{},"children":[]}]},{"type":"section","props":{"id":"mwBA"},"children":[{"type":"section","props":{"id":"mwBg"},"children":[]},{"type":"section","props":{"id":"mwCA"},"children":[{"type":"h2","props":{"id":"Star_Cannon"},"children":["Star Cannon"]},"\n"]},{"type":"span","props":{"id":"mwCQ"},"children":["\n\n\n"]},{"type":"p","props":{},"children":[]},{"type":"span","props":{"id":"mwCw"},"children":["\n\n"]},"\n",{"type":"div","props":{"id":"mwDQ"},"children":["\n",{"type":"div","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Wiki media omitted"]}]}]},"\n",{"type":"dl","props":{},"children":[{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":[{"type":"i","props":{},"children":["OH SURE, HOW CONVENIENT! A LITERAL CANNON? Do the creators HATE US OR SOMETHING? THEY ALL SUCK!"]},{"type":"br","props":{},"children":[]},{"type":"span","props":{},"children":[{"type":"span","props":{},"children":[]}]}]}]},"\n",{"type":"dd","props":{},"children":[{"type":"span","props":{},"children":["―"]},{"type":"a","props":{"href":"/w/Narrator_(Narrator)","title":"Narrator (Narrator)"},"children":["Narrator"]}," on Wave 29 (",{"type":"a","props":{"href":"/w/Blind_Faith","title":"Blind Faith"},"children":["Blind Faith"]},")"]}]}]},"\n"]},"\n"]},{"type":"section","props":{"id":"mwDg"},"children":[{"type":"h2","props":{"id":"Description"},"children":["Description"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Star Cannon"]}," is an interactable map object in the ",{"type":"a","props":{"href":"/w/Blind_Faith","title":"Blind Faith"},"children":["Blind Faith"]}," map as part of the ",{"type":"a","props":{"href":"/w/Null_&_Void_Event","title":"Null & Void Event"},"children":["Null & Void Event"]},", and also has previously appeared in ",{"type":"a","props":{"href":"/w/Totality_Tower","title":"Totality Tower"},"children":["Totality Tower"]}," as part of the ",{"type":"a","props":{"href":"/w/Solar_Eclipse_Event","title":"Solar Eclipse Event"},"children":["Solar Eclipse Event"]},". The ",{"type":"b","props":{},"children":["Star Cannon's"]}," main purpose is to stop ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," and ",{"type":"a","props":{"href":"/w/Rift_Walker","title":"Rift Walker"},"children":["Rift Walker"]}," from performing their abilities which, if not prevented, damage the base health and potentially kill the player. For both events it required three ",{"type":"a","props":{"href":"/w/Charge_(Item)","title":"Charge (Item)"},"children":["Charges"]},"."]},"\n\n",{"type":"p","props":{},"children":["To use the ",{"type":"b","props":{},"children":["Star Cannon"]}," in the ",{"type":"a","props":{"href":"/w/Null_&_Void_Event","title":"Null & Void Event"},"children":["Null & Void Event"]},", players must first collect eight ",{"type":"b","props":{},"children":["Star Cannon"]}," parts scattered around the map, available from Wave 7. Shards starts at ",{"type":"span","props":{"id":"mwHQ"},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Cash"]}]},"$500"]}," and increases by ",{"type":"span","props":{"id":"mwHg"},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Cash"]}]},"$500"]}," with each subsequent shard, for a total of ",{"type":"span","props":{"id":"mwHw"},"children":[{"type":"span","props":{},"children":[{"type":"span","props":{},"children":["Cash"]}]},"$18,000"]},". Once completed, it takes three ",{"type":"a","props":{"href":"/w/Charge_(Item)","title":"Charge (Item)"},"children":["Charges"]}," to fire. These fall down from the sky, but only if the ",{"type":"b","props":{},"children":["Star Cannon"]}," is not fully loaded. Its main use is to stop the ",{"type":"a","props":{"href":"/w/Rift_Walker","title":"Rift Walker"},"children":["Rift Walker"]}," from performing its ",{"type":"i","props":{},"children":["Lord Exo's Rebirth"]}," ability, though it can also be used to deal 1,000 damage to an enemy per use."]},"\n\n",{"type":"p","props":{},"children":["In the ",{"type":"a","props":{"href":"/w/Solar_Eclipse_Event","title":"Solar Eclipse Event"},"children":["Solar Eclipse Event"]},", its mechanics were similar — the ",{"type":"b","props":{},"children":["Star Cannon"]}," would fire at ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," when activated by the player, stunning it. Similarly, it required three ",{"type":"a","props":{"href":"/w/Charge_(Item)","title":"Charge (Item)"},"children":["Charges"]}," to fire and had a 60-second cooldown. ",{"type":"a","props":{"href":"/w/Charge_(Item)","title":"Charge (Item)"},"children":["Charges"]}," could be collected from around the map. During this event, its main use was to prevent ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," from using its ",{"type":"i","props":{},"children":["Shot of the Century"]}," ability, which would damage the base otherwise."]},"\n\n"]},{"type":"section","props":{"id":"mwLA"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["Star Cannon"]}," is a large white, yellow, grey and dark grey cannon. It had a yellow star on the side and a neon light on top of it.During the ",{"type":"a","props":{"href":"/w/Null_&_Void_Event","title":"Null & Void Event"},"children":["Null & Void Event"]}," in the ",{"type":"a","props":{"href":"/w/Blind_Faith","title":"Blind Faith"},"children":["Blind Faith"]}," map, it was located near the exit. During the ",{"type":"a","props":{"href":"/w/Solar_Eclipse_Event","title":"Solar Eclipse Event"},"children":["Solar Eclipse Event"]},", It always faced ",{"type":"a","props":{"href":"/w/The_Umbra","title":"The Umbra"},"children":["The Umbra"]}," even if it was not charged. It was attached on top of the exit. "]},"\n\n"]},{"type":"section","props":{"id":"mwMw"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["While available to rebuild from Wave 7, it is not recommended to actually rebuild it this early as the ",{"type":"b","props":{},"children":["Star Cannon"]}," serves very little use early on.\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["It is best bought around five waves before Wave 30."]}]}]},"\n",{"type":"li","props":{},"children":["The ",{"type":"a","props":{"href":"/w/Rift_Walker","title":"Rift Walker"},"children":["Rift Walker"]}," will have ",{"type":"a","props":{"href":"/w/Lord_Exo","title":"Lord Exo"},"children":["Lord Exo"]}," come out of its body while also turning the entire map yellow, this is when the player should be using the ",{"type":"b","props":{},"children":["Star Cannon"]},".\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["It is recommended to prevent the ability every time, as the ability only requires two successful uses to end the match."]},"\n",{"type":"li","props":{},"children":[{"type":"a","props":{"href":"/w/The_Fool","title":"The Fool"},"children":["The Fool"]}," reduces this further to one successful shot. If no one in the team can time the ",{"type":"b","props":{},"children":["Star Cannon"]}," well, ",{"type":"a","props":{"href":"/w/The_Fool","title":"The Fool"},"children":["The Fool"]}," is best avoided."]}]}]},"\n",{"type":"li","props":{},"children":["In the Easy difficulty of ",{"type":"a","props":{"href":"/w/Blind_Faith","title":"Blind Faith"},"children":["Blind Faith"]},", it is actually entirely possible to not purchase the ",{"type":"b","props":{},"children":["Star Cannon"]},", especially if the player has overheal from ",{"type":"a","props":{"href":"/w/Skills","title":"Skills"},"children":["Skills"]},", which allows them to tank more shots."]}]},"\n\n"]},{"type":"section","props":{"id":"mwRw"},"children":[{"type":"h2","props":{"id":"Trivia"},"children":["Trivia"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Star Cannon"]}," was inspired from the ",{"type":"a","props":{"href":"https://terraria.wiki.gg/wiki/Star_Cannon"},"children":["Star Cannon"]}," from ",{"type":"i","props":{},"children":["Terraria"]}," and the ",{"type":"a","props":{"href":"https://battlecats.miraheze.org/wiki/Cat_Cannon#Cannon_Types"},"children":["Thunderbolt Cat Cannon"]}," from ",{"type":"i","props":{},"children":["Battle Cats"]},"."]},"\n",{"type":"li","props":{},"children":["This and the ",{"type":"a","props":{"href":"/w/Charge_(Item)","title":"Charge (Item)"},"children":["Charges"]}," were the first interactable objects inside a match."]},"\n",{"type":"li","props":{},"children":["It was possible to get stuck on a certain part near the top of the cannon."]},"\n",{"type":"li","props":{},"children":["The ",{"type":"b","props":{},"children":["Star Cannon"]}," appears in the 2025 Halloween lobby event area and as one of the falling props in ",{"type":"a","props":{"href":"/w/Banlands","title":"Banlands"},"children":["Banlands"]},"."]}]},"\n\n"]},{"type":"section","props":{"id":"mwVQ"},"children":[{"type":"h2","props":{"id":"Update_History"},"children":["Update History"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["13 December 2021"]}," - ",{"type":"a","props":{"href":"/w/V1.0.0","title":"V1.0.0"},"children":["v1.0.0g"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Star Cannon"]}," added."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["26 January 2022"]}," - ",{"type":"a","props":{"href":"/w/V1.0.1","title":"V1.0.1"},"children":["v1.0.1"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Star Cannon"]}," removed."]}]}]},"\n",{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["1 November 2025"]}," - ",{"type":"a","props":{"href":"/w/V1.79.0","title":"V1.79.0"},"children":["v1.79.0"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":[{"type":"b","props":{},"children":["Star Cannon"]}," re-added."]}]}]}]},"\n",{"type":"p","props":{},"children":["\n",{"type":"br","props":{},"children":[]}]},"\n\n",{"type":"div","props":{"id":"mwaw"},"children":[]},{"type":"div","props":{"id":"mwbA"},"children":["\n",{"type":"div","props":{},"children":[{"type":"figure","props":{},"children":[{"type":"a","props":{"href":"/w/Interactables","title":"Interactables"},"children":["Wiki media omitted"]},{"type":"figcaption","props":{},"children":[]}]}]},"\n",{"type":"table","props":{},"children":["\n",{"type":"tbody","props":{},"children":[{"type":"tr","props":{},"children":["\n",{"type":"th","props":{},"children":[{"type":"span","props":{},"children":["Offensive Objects"]}]},"\n",{"type":"td","props":{"colSpan":2},"children":[{