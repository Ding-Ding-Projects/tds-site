","props":{"href":"/w/Mid_Grade_Crate","title":"Mid Grade Crate"},"children":["Mid Grade Crate"]},"."]},"\n\n",{"type":"p","props":{},"children":["Only up to four ",{"type":"b","props":{},"children":["UAVs"]}," can be used in a match by a single player. It has a 50 second cooldown, though when the match first starts the cooldown is set to 40 seconds. The cooldown does not appear until the ",{"type":"b","props":{},"children":["UAV"]}," consumable has ended."]},"\n\n"]},{"type":"section","props":{"id":"mwGQ"},"children":[{"type":"h2","props":{"id":"Usage"},"children":["Usage"]},"\n",{"type":"p","props":{},"children":["Unlike all other consumables, the ",{"type":"b","props":{},"children":["UAV"]}," is instantly activated upon being chosen. This will cause the ",{"type":"b","props":{},"children":["UAV"]}," to appear in the sky and circle the map for 30 seconds, giving all towers 30% more range, hidden detection and flying detection."]},"\n\n"]},{"type":"section","props":{"id":"mwHQ"},"children":[{"type":"h2","props":{"id":"Appearance"},"children":["Appearance"]},"\n",{"type":"p","props":{},"children":["The ",{"type":"b","props":{},"children":["UAV"]}," is a grey MQ-9 Reaper. The inventory and hotbar icon shows the blue range icon in the top right corner to indicate that it is the ",{"type":"b","props":{},"children":["UAV"]}," consumable."]},"\n\n"]},{"type":"section","props":{"id":"mwIQ"},"children":[{"type":"h2","props":{"id":"Strategy"},"children":["Strategy"]},"\n",{"type":"ul","props":{},"children":[{"type":"li","props":{},"children":["If you do not have proper defenses to deal with hidden enemies, such as the ",{"type":"a","props":{"href":"/w/Hidden","title":"Hidden"},"children":["Hidden"]},", ",{"type":"a","props":{"href":"/w/Hidden_Boss","title":"Hidden Boss"},"children":["Hidden Boss"]},", ",{"type":"a","props":{"href":"/w/Shadow","title":"Shadow"},"children":["Shadow"]}," or ",{"type":"a","props":{"href":"/w/Shadow_Boss","title":"Shadow Boss"},"children":["Shad